{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Onion Studio Wizard",
  "version": "0.1.0",
  "identifier": "com.mkb0020.onionstudiowizard",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Onion Studio Wizard",
        "width": 1500,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
