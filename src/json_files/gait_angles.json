{
  "meta": {
    "description": "Side-view gait joint angles for run and walk cycles, for rig animation.",
    "units": "degrees",
    "sideView": "Camera sees the character's right side. Right limbs are near, left limbs are far.",
    "convention": "Positive = forward (direction of travel), negative = behind. Each angle is measured from the vertical line straight down from the parent joint to the child joint.",
    "ranges": "Every angle is [min, max]. Pick a value within the range (the midpoint is a good default), or tween between min and max for variation.",
    "joints": {
      "thigh": "Hip to knee, angle at the hip circle",
      "shin": "Knee to ankle, angle at the knee circle. Equals thigh angle minus knee bend.",
      "upperArm": "Shoulder to elbow, angle at the shoulder circle",
      "forearm": "Elbow to wrist, angle at the elbow circle. Equals upper arm angle plus elbow bend."
    },
    "poseNaming": "Poses are named for the leg doing the action. Arms swing opposite the legs: the right arm goes with the left leg, and the left arm goes with the right leg.",
    "caveats": "Stylized, readable values for animation, not mocap data. Shin and forearm should lag the thigh and upper arm by 1 to 2 frames for follow-through."
  },
  "cycles": {
    "run": {
      "poseOrder": [
        "left_passing", "left_takeoff", "left_up", "left_contact",
        "right_passing", "right_takeoff", "right_up", "right_contact"
      ],
      "speedScale": { "slowJog": 0.7, "default": 1.0, "sprint": 1.3 },
      "notes": [
        "Knee bend: about 100-115 deg on the swing leg at passing, 90-110 deg at up, 10-20 deg at contact, 20-35 deg on the push-off leg at takeoff.",
        "Shin values past -90 mean the ankle is above the knee (heel flick). Clamp to about -90 for a casual jog.",
        "Elbow bend: about 90-105 deg on the forward swing, 70-80 deg at the front, 60-75 deg on the back swing.",
        "Trailing thigh rarely goes past about -25 deg.",
        "Hand reaches roughly chest or chin height at the front of the swing and passes beside the hip at the back."
      ],
      "poses": {
        "left_passing": {
          "legs": {
            "left":  { "thigh": [10, 20],   "shin": [-100, -90] },
            "right": { "thigh": [-20, -10],    "shin": [-45, -35] }
          },
          "arms": {
            "left":  { "upperArm": [-80, -70],    "forearm": [25, 35] },
